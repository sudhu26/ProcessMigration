CREATE OR REPLACE PACKAGE BODY RISK_CALC_PKG AS

  PROCEDURE CALC_EXPOSURE(p_asof DATE) IS
    v_total NUMBER;
  BEGIN
    SELECT SUM(EXPOSURE) INTO v_total
    FROM RISK_POSITIONS
    WHERE AS_OF_DATE = p_asof;

    INSERT INTO RISK_RESULTS(BOOK, TOTAL_EXPOSURE, AS_OF_DATE)
    SELECT BOOK, SUM(EXPOSURE), p_asof
    FROM RISK_POSITIONS
    WHERE AS_OF_DATE = p_asof
    GROUP BY BOOK;

    EXECUTE IMMEDIATE 'ANALYZE TABLE RISK_RESULTS COMPUTE STATISTICS';
    DBMS_OUTPUT.PUT_LINE('done');
  EXCEPTION
    WHEN OTHERS THEN
      ROLLBACK;
      RAISE;
  END;

END RISK_CALC_PKG;
/
